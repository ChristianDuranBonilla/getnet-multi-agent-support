# Vertex AI (Gemini 3.x models are served from the global endpoint)
GOOGLE_GENAI_USE_VERTEXAI=true
GOOGLE_CLOUD_PROJECT=ai-hardcore-engineer-getnet
GOOGLE_CLOUD_LOCATION=global
# Local development uses Application Default Credentials; Docker mounts the service-account key here
# GOOGLE_APPLICATION_CREDENTIALS=/run/secrets/sa-key.json

LLM_MODEL=gemini-3.8-flash
LLM_TIMEOUT_SECONDS=30
EMBEDDING_MODEL=gemini-embedding-2

CHROMA_DIR=data/chroma
CHROMA_COLLECTION=getnet_kb
RAG_TOP_K=5
RAG_DISTANCE_THRESHOLD=0.38

LOG_LEVEL=INFO
