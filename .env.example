# Copy to .env and adjust. Every variable has the same default in app/config.py.

# Gemini provider. Vertex AI (default) authenticates with the service account in
# GOOGLE_APPLICATION_CREDENTIALS. Setting GOOGLE_GENAI_USE_VERTEXAI=false routes the same
# models through the Gemini Developer API with GOOGLE_API_KEY instead (a provider fallback
# when a project is unavailable; project and location are then ignored).
GOOGLE_GENAI_USE_VERTEXAI=true
GOOGLE_CLOUD_PROJECT=project-c5433621-6dff-41da-8f3
GOOGLE_CLOUD_LOCATION=global
# GOOGLE_API_KEY=
LLM_MODEL=gemini-3.8-flash
LLM_TIMEOUT_SECONDS=30
LLM_MAX_RETRIES=1
# Tried once when the primary model times out or returns 5xx; empty disables it.
LLM_FALLBACK_MODEL=gemini-3.5-flash
# List prices in USD per million tokens, read on 2026-11-19 from the Vertex AI pricing
# page; verify before relying on the cost estimate.
LLM_PRICE_INPUT_PER_MTOK=0.50
LLM_PRICE_OUTPUT_PER_MTOK=3.00
EMBEDDING_MODEL=gemini-embedding-2

# Retrieval
CHROMA_DIR=data/chroma
CHROMA_COLLECTION=getnet_kb
RAG_TOP_K=5
RAG_DISTANCE_THRESHOLD=0.38
RAG_MODE=dense

# State (conversations, tickets, checkpoints)
STATE_DIR=data/state
MEMORY_WINDOW_TURNS=6
MEMORY_SUMMARY_EVERY=10
MAX_HOPS=1

# Security
# Required for the operator endpoints; empty or the placeholder never authenticates.
# scripts/evaluate.sh generates one into .env when none is set.
OPERATOR_API_KEY=
LOG_SALT=dev-salt
RATE_LIMIT_PER_MINUTE=30
RATE_LIMIT_BURST=10
GUARDRAIL_FAIL_MODE=closed

# Observability
LOG_LEVEL=INFO
OTEL_EXPORTER_OTLP_ENDPOINT=
